# Server
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://zssuffmrgchloymtgmlo.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firecrawl (optional - for render mode)
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Cache
CACHE_TTL_SECONDS=600

# Rate limiting
MAX_CONCURRENT_REQUESTS=3
REQUEST_DELAY_MS=1000

# Authentication
ADMIN_USER=admin
ADMIN_PASS=admin
SESSION_SECRET=change-me-to-a-random-32-character-string
SESSION_MAX_AGE_MS=28800000

# Encryption (passwords at rest)
# 32-byte key (Base64). To generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SUPPLIER_CREDS_ENC_KEY=

# Enable headless login + search with Playwright
ENABLE_PLAYWRIGHT_LOGIN=1
PLAYWRIGHT_NAV_TIMEOUT_MS=25000
